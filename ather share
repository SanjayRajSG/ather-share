<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AtherShare — P2P EV Community Charging & Emergency SOS Network</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            ather: {
              bg: '#0A0D10',
              card: '#13181D',
              panel: '#1A2129',
              mint: '#00D59D',
              mintDark: '#00A87B',
              danger: '#FF3B30',
              warning: '#FF9F0A',
              grid: '#38BDF8'
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #0A0D10;
      color: #F3F4F6;
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0A0D10;
    }
    ::-webkit-scrollbar-thumb {
      background: #1F2937;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #00D59D;
    }

    /* Radar Sweep Animation */
    @keyframes radarSpin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .radar-sweep {
      background: conic-gradient(from 0deg, rgba(0, 213, 157, 0.38) 0deg, rgba(0, 213, 157, 0.0) 90deg, transparent 360deg);
      animation: radarSpin 4s linear infinite;
    }
    .radar-sweep-sos {
      background: conic-gradient(from 0deg, rgba(255, 59, 48, 0.45) 0deg, rgba(255, 59, 48, 0.0) 95deg, transparent 360deg);
      animation: radarSpin 2.2s linear infinite;
    }

    /* Pulse ring for markers */
    @keyframes pulseRing {
      0% { transform: scale(0.8); opacity: 0.9; }
      100% { transform: scale(2.4); opacity: 0; }
    }
    .pulse-ring::before {
      content: '';
      position: absolute;
      inset: -6px;
      border-radius: 9999px;
      border: 2px solid currentColor;
      animation: pulseRing 1.8s cubic-bezier(0.24, 0, 0.38, 1) infinite;
    }

    /* Custom Range Slider */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
    }
    input[type="range"]::-webkit-slider-runnable-track {
      height: 8px;
      border-radius: 999px;
      background: #1F2937;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      margin-top: -5px;
      background-color: #00D59D;
      height: 18px;
      width: 18px;
      border-radius: 999px;
      border: 2px solid #0A0D10;
      box-shadow: 0 0 10px rgba(0, 213, 157, 0.8);
    }

    /* Glowing Mint Border */
    .mint-glow {
      box-shadow: 0 0 25px -5px rgba(0, 213, 157, 0.35);
    }
    .danger-glow {
      box-shadow: 0 0 28px -4px rgba(255, 59, 48, 0.5);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-ather-mint selection:text-black">

  <!-- TOP NAVIGATION BAR -->
  <header class="sticky top-0 z-40 backdrop-blur-xl bg-ather-bg/90 border-b border-gray-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <!-- Brand Logo -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-ather-mint/15 border border-ather-mint/50 flex items-center justify-center text-ather-mint shadow-lg shadow-ather-mint/10">
          <i class="fa-solid fa-bolt-lightning text-lg"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold tracking-tight text-lg text-white">ATHER<span class="text-ather-mint">SHARE</span></span>
            <span class="text-[10px] font-mono uppercase tracking-widest px-2 py-0.5 rounded-full bg-ather-mint/15 text-ather-mint border border-ather-mint/30">P2P Grid</span>
          </div>
          <p class="text-xs text-gray-400 hidden sm:block">Community Rescue & Home Charger Sharing Network • Bengaluru</p>
        </div>
      </div>

      <!-- 3-Mode Switcher -->
      <div class="flex items-center bg-ather-card p-1 rounded-xl border border-gray-800">
        <button id="tab-rider" onclick="switchMode('rider')" class="flex items-center gap-2 px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all bg-ather-mint text-black shadow">
          <i class="fa-solid fa-motorcycle"></i>
          <span>Rider SOS</span>
        </button>
        <button id="tab-host" onclick="switchMode('host')" class="flex items-center gap-2 px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all text-gray-400 hover:text-white">
          <i class="fa-solid fa-plug-circle-check"></i>
          <span>Host Mode</span>
          <span id="host-ping-badge" class="px-1.5 py-0.2 text-[10px] font-mono rounded-full bg-ather-danger text-white">2</span>
        </button>
        <button id="tab-dev" onclick="switchMode('dev')" class="flex items-center gap-2 px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all text-gray-400 hover:text-white">
          <i class="fa-solid fa-wallet text-ather-mint"></i>
          <span>Dev Wallet</span>
          <span id="nav-dev-balance" class="font-mono text-xs px-1.5 py-0.5 rounded bg-ather-mint/20 text-ather-mint border border-ather-mint/30">₹140</span>
        </button>
      </div>

      <!-- Sound & Active Session Pill -->
      <div class="hidden lg:flex items-center gap-3">
        <div class="px-3 py-1.5 rounded-xl bg-ather-card border border-gray-800 flex items-center gap-2 text-xs">
          <span class="w-2 h-2 rounded-full bg-ather-mint animate-ping"></span>
          <span class="text-gray-400">Tariff:</span>
          <span class="font-mono font-bold text-white">₹150/session</span>
          <span class="text-[11px] text-ather-mint font-mono">(₹140 Host + ₹10 Dev)</span>
        </div>
        <button id="sound-btn" onclick="toggleSound()" class="p-2.5 rounded-xl bg-ather-card border border-gray-800 text-gray-300 hover:text-ather-mint hover:border-ather-mint/40 transition" title="Toggle Radar Audio">
          <i id="sound-icon" class="fa-solid fa-volume-high"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- CRITICAL LOW BATTERY EMERGENCY BANNER -->
  <div id="critical-banner" class="bg-gradient-to-r from-red-950/90 via-red-900/80 to-red-950/90 border-b border-red-500/40 px-4 py-2.5 transition-all">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2 text-xs sm:text-sm">
      <div class="flex items-center gap-2.5">
        <span class="px-2 py-0.5 rounded bg-red-600 text-white font-mono font-bold uppercase text-[11px] animate-pulse">CRITICAL SoC</span>
        <span class="text-red-100 font-medium">Battery at <strong id="banner-soc" class="font-mono underline">7%</strong> (~<span id="banner-range">5.2</span> km left). Nearest public Ather Grid is 6.8 km away (Out of safe range).</span>
      </div>
      <button onclick="triggerEmergencySOS()" class="px-3 py-1 rounded-lg bg-white text-red-700 font-bold text-xs hover:bg-red-100 transition flex items-center gap-1.5 shadow">
        <i class="fa-solid fa-tower-broadcast"></i> Ping Nearby Home Chargers Now
      </button>
    </div>
  </div>

  <!-- ACTIVE LIVE CHARGING BAR (Hidden until a ₹150 payment is completed) -->
  <div id="active-charging-bar" class="hidden bg-ather-mint/15 border-b border-ather-mint/40 px-4 py-3">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-ather-mint text-black flex items-center justify-center font-bold animate-pulse">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono uppercase tracking-wider text-ather-mint font-bold">LIVE P2P CHARGING SESSION ACTIVE</span>
            <span id="active-session-host" class="text-xs bg-black/50 px-2 py-0.5 rounded text-white font-medium">Host: Karthik Rao</span>
          </div>
          <p class="text-xs text-gray-300">₹150 Paid via AtherPay Split (<span class="text-ather-mint">₹140 Host Credited</span> • <span class="text-sky-400">₹10 Dev Commission Credited</span>)</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <div class="text-right font-mono">
          <div class="text-xs text-gray-400">Energy Added / Timer</div>
          <div class="text-sm font-bold text-ather-mint"><span id="charge-kwh">0.42</span> kWh • <span id="charge-timer">00:45</span></div>
        </div>
        <button onclick="stopChargingSession()" class="px-3 py-1.5 rounded-lg bg-red-500/20 border border-red-500/40 text-red-300 hover:bg-red-500 hover:text-white text-xs font-semibold transition">
          Finish Session
        </button>
      </div>
    </div>
  </div>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6">

    <!-- ========================================== -->
    <!-- VIEW 1: RIDER SOS & PROXIMITY RADAR MODE   -->
    <!-- ========================================== -->
    <section id="view-rider" class="space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- LEFT COLUMN: TELEMETRY, SCOOTER SELECTOR & SOS CONTROLS (4 Cols) -->
        <div class="lg:col-span-4 space-y-5">

          <!-- Scooter Telemetry Card -->
          <div id="telemetry-card" class="bg-ather-card rounded-2xl p-5 border border-red-500/40 danger-glow transition-all">
            <div class="flex items-center justify-between mb-4">
              <div>
                <span class="text-[11px] font-mono uppercase tracking-wider text-gray-400">MY ATHER TELEMETRY</span>
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                  <span id="selected-model-title">Ather 450X (Gen 3)</span>
                  <span class="text-xs font-mono px-2 py-0.5 rounded bg-gray-800 text-ather-mint">KA-01-JS-4509</span>
                </h2>
              </div>
              <div id="soc-badge" class="px-2.5 py-1 rounded-lg bg-red-500/20 border border-red-500/40 text-red-400 font-mono text-xs font-bold">
                SOS READY
              </div>
            </div>

            <!-- Scooter Model Selector Pills -->
            <div class="mb-4">
              <label class="text-xs text-gray-400 block mb-2">Select Your Ather Scooter Model:</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-2" id="model-buttons">
                <button onclick="selectModel('Ather 450X', 0.85)" class="model-btn px-3 py-2 rounded-xl text-xs font-semibold border border-ather-mint bg-ather-mint/15 text-ather-mint text-left flex items-center justify-between">
                  <span>450X</span>
                  <i class="fa-solid fa-check text-[10px]"></i>
                </button>
                <button onclick="selectModel('Ather 450 Apex', 0.90)" class="model-btn px-3 py-2 rounded-xl text-xs font-semibold border border-gray-800 bg-ather-panel text-gray-300 hover:border-gray-700 text-left flex items-center justify-between">
                  <span>450 Apex</span>
                </button>
                <button onclick="selectModel('Ather 450S', 0.75)" class="model-btn px-3 py-2 rounded-xl text-xs font-semibold border border-gray-800 bg-ather-panel text-gray-300 hover:border-gray-700 text-left flex items-center justify-between">
                  <span>450S</span>
                </button>
                <button onclick="selectModel('Ather Rizta Z', 0.95)" class="model-btn px-3 py-2 rounded-xl text-xs font-semibold border border-gray-800 bg-ather-panel text-gray-300 hover:border-gray-700 text-left flex items-center justify-between">
                  <span>Rizta Z</span>
                </button>
              </div>
            </div>

            <!-- Battery Gauge & Slider -->
            <div class="bg-ather-bg/80 rounded-xl p-4 border border-gray-800/90 mb-4">
              <div class="flex items-baseline justify-between mb-2">
                <div>
                  <span class="text-xs text-gray-400 block">Current Battery (SoC)</span>
                  <span id="battery-pct-display" class="text-4xl font-extrabold font-mono text-red-500">7%</span>
                </div>
                <div class="text-right">
                  <span class="text-xs text-gray-400 block">Est. TrueRange™</span>
                  <span id="range-display" class="text-2xl font-bold font-mono text-white">5.9 <span class="text-sm font-normal text-gray-400">km</span></span>
                </div>
              </div>

              <!-- Visual Battery Bar -->
              <div class="w-full h-3 bg-gray-800 rounded-full overflow-hidden mb-3 p-0.5">
                <div id="battery-bar-fill" class="h-full rounded-full bg-red-500 transition-all duration-300" style="width: 7%"></div>
              </div>

              <div class="flex items-center justify-between text-[11px] text-gray-400 mb-1">
                <span>Simulate Battery Level:</span>
                <span class="font-mono text-gray-300">Drag Slider (1% - 100%)</span>
              </div>
              <input id="battery-slider" type="range" min="1" max="100" value="7" oninput="updateBattery(this.value)" class="w-full" />
            </div>

            <!-- Situation Summary Box -->
            <div class="rounded-xl bg-ather-panel/80 p-3.5 border border-gray-800 text-xs space-y-2 mb-4">
              <div class="flex items-center justify-between">
                <span class="text-gray-400"><i class="fa-solid fa-plug-circle-xmark text-red-400 mr-1.5"></i>Portable Charger:</span>
                <span class="font-semibold text-red-300">Not Carried (Left at Home)</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-gray-400"><i class="fa-solid fa-charging-station text-sky-400 mr-1.5"></i>Nearest Ather Grid:</span>
                <span class="font-mono text-gray-200">6.8 km away (Indiranagar)</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-gray-400"><i class="fa-solid fa-house-signal text-ather-mint mr-1.5"></i>Closest Home Host:</span>
                <span class="font-mono text-ather-mint font-bold">0.6 km away (2 mins)</span>
              </div>
            </div>

            <!-- One-Tap Broadcast Emergency SOS Button -->
            <button id="sos-btn" onclick="triggerEmergencySOS()" class="w-full py-3.5 px-4 rounded-xl font-bold text-sm bg-gradient-to-r from-red-600 to-orange-600 hover:from-red-500 hover:to-orange-500 text-white shadow-lg shadow-red-600/30 transition flex items-center justify-center gap-2.5">
              <i class="fa-solid fa-tower-broadcast animate-pulse"></i>
              <span id="sos-btn-text">BROADCAST EMERGENCY SOS PING</span>
            </button>
          </div>

          <!-- Transparent ₹150 Split Tariff Explainer Card -->
          <div class="bg-ather-card rounded-2xl p-5 border border-gray-800">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono uppercase tracking-wider text-ather-mint font-semibold">COMMUNITY RESCUE TARIFF</span>
              <span class="px-2 py-0.5 rounded bg-ather-mint/15 text-ather-mint font-mono text-xs font-bold">Flat ₹150</span>
            </div>
            <p class="text-xs text-gray-400 mb-4">
              No haggling during an emergency. Pay a flat <strong class="text-white">₹150</strong> for a 45-minute rescue top-up (~35 km range added) at any verified Ather owner's house.
            </p>
            <div class="grid grid-cols-2 gap-2.5 text-center">
              <div class="p-3 rounded-xl bg-ather-panel border border-gray-800">
                <div class="text-xs text-gray-400 mb-0.5">Host Homeowner Gets</div>
                <div class="text-xl font-extrabold font-mono text-ather-mint">₹140</div>
                <div class="text-[10px] text-gray-400">Covers power + reward</div>
              </div>
              <div class="p-3 rounded-xl bg-ather-panel border border-gray-800">
                <div class="text-xs text-gray-400 mb-0.5">App Developer Cut</div>
                <div class="text-xl font-extrabold font-mono text-sky-400">₹10</div>
                <div class="text-[10px] text-gray-400">6.67% Platform Fee</div>
              </div>
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN: INTERACTIVE PROXIMITY RADAR & NEARBY HOSTS LIST (8 Cols) -->
        <div class="lg:col-span-8 space-y-5">

          <!-- Interactive Radar + Filter Controls Card -->
          <div class="bg-ather-card rounded-2xl p-5 border border-gray-800">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
              <div>
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-ather-mint animate-ping"></span>
                  <h3 class="font-bold text-white text-base sm:text-lg">Live Proximity Charger Radar — HSR / Koramangala Sector</h3>
                </div>
                <p class="text-xs text-gray-400">Tap any radar node or host card below to message, preview route, or unlock charger for ₹150</p>
              </div>

              <!-- Search Radius Slider -->
              <div class="bg-ather-panel px-3.5 py-2 rounded-xl border border-gray-800 flex items-center gap-3">
                <div class="text-xs">
                  <span class="text-gray-400">Scan Radius:</span>
                  <span id="radius-label" class="font-mono font-bold text-ather-mint ml-1">5.0 km</span>
                </div>
                <input id="radius-slider" type="range" min="0.5" max="15" step="0.5" value="5.0" oninput="updateRadius(this.value)" class="w-28 sm:w-36" />
              </div>
            </div>

            <!-- RADAR VISUALIZER CANVAS BOX -->
            <div class="relative w-full h-72 sm:h-80 rounded-2xl bg-[#070A0D] border border-gray-800 overflow-hidden flex items-center justify-center select-none">
              <!-- Subtle Map Grid Lines -->
              <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(#00D59D 1px, transparent 1px), linear-gradient(to right, #1E293B 1px, transparent 1px), linear-gradient(to bottom, #1E293B 1px, transparent 1px); background-size: 28px 28px;"></div>

              <!-- Concentric Radar Rings -->
              <div class="relative w-64 h-64 sm:w-72 sm:h-72 rounded-full border border-ather-mint/25 flex items-center justify-center">
                <div class="w-44 h-44 sm:w-52 sm:h-52 rounded-full border border-ather-mint/20 flex items-center justify-center">
                  <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border border-ather-mint/25"></div>
                </div>

                <!-- Rotating Radar Sweep -->
                <div id="radar-sweep-cone" class=" absolute inset-0 rounded-full radar-sweep pointer-events-none"></div>

                <!-- Crosshairs -->
                <div class="absolute inset-x-0 h-px bg-ather-mint/15 pointer-events-none"></div>
                <div class="absolute inset-y-0 w-px bg-ather-mint/15 pointer-events-none"></div>

                <!-- Center Rider Marker (You) -->
                <div class="relative z-20 w-9 h-9 rounded-full bg-red-600 text-white border-2 border-white flex items-center justify-center shadow-lg pulse-ring" title="Your Location (Stranded Rider)">
                  <i class="fa-solid fa-motorcycle text-xs"></i>
                </div>

                <!-- Dynamic Host Nodes Injected via JS -->
                <div id="radar-nodes-container" class="absolute inset-0"></div>
              </div>

              <!-- Radar Legend Overlay -->
              <div class="absolute bottom-3 left-3 right-3 flex flex-wrap items-center justify-between gap-2 pointer-events-none text-[11px]">
                <div class="flex flex-wrap items-center gap-3 bg-black/75 backdrop-blur-md px-3 py-1.5 rounded-xl border border-gray-800">
                  <span class="flex items-center gap-1.5 text-gray-300"><span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span> You (<span id="radar-you-soc">7%</span>)</span>
                  <span class="flex items-center gap-1.5 text-gray-300"><span class="w-2.5 h-2.5 rounded-full bg-ather-mint inline-block"></span> Home Host (₹150)</span>
                  <span class="flex items-center gap-1.5 text-gray-300"><span class="w-2.5 h-2.5 rounded-full bg-sky-400 inline-block"></span> Public Ather Grid</span>
                </div>
                <div id="radar-status-pill" class="bg-black/75 backdrop-blur-md px-3 py-1.5 rounded-xl border border-gray-800 font-mono text-ather-mint">
                  <span id="visible-hosts-count">5</span> Chargers in Range
                </div>
              </div>
            </div>

            <!-- Filter Pills -->
            <div class="flex flex-wrap items-center justify-between gap-2 mt-4">
              <div class="flex flex-wrap items-center gap-2">
                <button onclick="setFilter('all')" id="filter-all" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-ather-mint text-black transition">
                  All Nearby
                </button>
                <button onclick="setFilter('dot')" id="filter-dot" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-ather-panel text-gray-300 border border-gray-800 hover:border-gray-700 transition">
                  <i class="fa-solid fa-bolt text-ather-mint mr-1"></i>Ather Dot Wallbox (3.3kW)
                </button>
                <button onclick="setFilter('portable')" id="filter-portable" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-ather-panel text-gray-300 border border-gray-800 hover:border-gray-700 transition">
                  <i class="fa-solid fa-plug text-amber-400 mr-1"></i>Portable Charger
                </button>
              </div>
              <span class="text-xs text-gray-400 font-mono">Sorted by: Nearest Distance</span>
            </div>
          </div>

          <!-- NEARBY VERIFIED HOSTS LIST -->
          <div id="hosts-list-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Populated dynamically via JS -->
          </div>

        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- VIEW 2: HOST DASHBOARD MODE                -->
    <!-- ========================================== -->
    <section id="view-host" class="hidden space-y-6">
      <!-- Host Top Banner & Availability Toggle -->
      <div class="bg-ather-card rounded-2xl p-6 border border-gray-800 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-ather-mint/15 border border-ather-mint/40 flex items-center justify-center text-ather-mint text-2xl">
            <i class="fa-solid fa-house-laptop"></i>
          </div>
          <div>
