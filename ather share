          <div class="w-7 h-7 rounded-lg bg-ather-mint/20 text-ather-mint flex items-center justify-center text-xs font-bold shrink-0">${selectedHost ? selectedHost.initials : 'KR'}</div>
          <div class="bg-ather-panel border border-gray-800 rounded-2xl rounded-tl-none px-3.5 py-2.5 text-xs text-gray-200 max-w-xs">
            Got it! Gate is open and the Ather Dot cable is switched ON. Come right in! ⚡
          </div>
        `;
        chatBox.appendChild(replyDiv);
        chatBox.scrollTop = chatBox.scrollHeight;
        playSynthBeep(560, 0.08);
      }, 900);
    }

    // --- HOST DASHBOARD LOGIC ---
    function toggleHostOnline() {
      hostOnline = !hostOnline;
      const btn = document.getElementById('host-toggle-btn');
      const label = document.getElementById('host-status-label');
      if (hostOnline) {
        btn.className = 'w-14 h-8 rounded-full bg-ather-mint p-1 transition-all flex items-center justify-end';
        label.textContent = 'ONLINE & ACCEPTING SOS';
        label.className = 'text-xs font-bold text-ather-mint uppercase font-mono';
        showToast('Your Home Charger is now ONLINE and visible to stranded Ather riders.');
      } else {
        btn.className = 'w-14 h-8 rounded-full bg-gray-700 p-1 transition-all flex items-center justify-start';
        label.textContent = 'OFFLINE (HIDDEN)';
        label.className = 'text-xs font-bold text-gray-400 uppercase font-mono';
        showToast('Your Home Charger is now OFFLINE.');
      }
    }

    function renderHostRequests() {
      const container = document.getElementById('host-requests-container');
      const badge = document.getElementById('host-ping-badge');
      badge.textContent = incomingSosRequests.length;

      if (incomingSosRequests.length === 0) {
        container.innerHTML = `
          <div class="p-8 rounded-xl bg-ather-panel/40 border border-gray-800 text-center space-y-2">
            <i class="fa-solid fa-circle-check text-ather-mint text-2xl"></i>
            <div class="text-sm font-semibold text-white">All Nearby Stranded Riders Assisted!</div>
            <p class="text-xs text-gray-400">Click "+ Simulate Rider Ping" above to test accepting a new ₹150 SOS request.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = '';
      incomingSosRequests.forEach(req => {
        const div = document.createElement('div');
        div.className = 'p-4 rounded-xl bg-ather-panel border border-gray-800 flex flex-wrap items-center justify-between gap-3';
        div.innerHTML = `
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-red-500/20 text-red-400 font-mono font-bold text-[10px] border border-red-500/30">${req.soc}% SoC SOS</span>
              <span class="font-bold text-white text-sm">${req.riderName}</span>
              <span class="text-xs text-gray-400">• ${req.scooter}</span>
            </div>
            <div class="text-xs text-gray-400 flex items-center gap-3">
              <span><i class="fa-solid fa-location-dot text-ather-mint mr-1"></i>${req.distance}</span>
              <span>• Rider Pays: <strong class="text-white font-mono">₹150</strong></span>
              <span class="text-ather-mint font-mono">(Your Net: ₹140 | App Fee: ₹10)</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="acceptHostRequest('${req.id}')" class="px-3.5 py-2 rounded-xl bg-ather-mint hover:bg-ather-mintDark text-black font-bold text-xs transition shadow">
              Accept & Earn ₹140
            </button>
            <button onclick="declineHostRequest('${req.id}')" class="px-3 py-2 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-300 text-xs font-semibold transition">
              Decline
            </button>
          </div>
        `;
        container.appendChild(div);
      });
    }

    function acceptHostRequest(reqId) {
      const req = incomingSosRequests.find(r => r.id === reqId);
      incomingSosRequests = incomingSosRequests.filter(r => r.id !== reqId);

      // Credit ₹140 to Host and ₹10 to Developer
      record150SplitTransaction(`${req.riderName}`, 'You (Host)');
      renderHostRequests();
      playSynthBeep(840, 0.15, 'triangle');
      showToast(`Accepted ${req.riderName}'s SOS! +₹140 credited to Host Wallet & +₹10 credited to Developer Wallet.`);
    }

    function declineHostRequest(reqId) {
      incomingSosRequests = incomingSosRequests.filter(r => r.id !== reqId);
      renderHostRequests();
      showToast('Request routed to next nearest Ather host.');
    }

    function simulateIncomingHostRequest() {
      const names = ['Raghavendra S', 'Sneha Menon', 'Kiran Kumar', 'Zoya Khan', 'Pranav Joshi'];
      const scooters = ['Ather 450X', 'Ather Rizta Z', 'Ather 450 Apex', 'Ather 450S'];
      const randomName = names[Math.floor(Math.random() * names.length)];
      const randomScooter = scooters[Math.floor(Math.random() * scooters.length)];
      const randomSoc = Math.floor(Math.random() * 6) + 4;

      incomingSosRequests.unshift({
        id: 'sos-' + Date.now(),
        riderName: randomName,
        scooter: randomScooter,
        soc: randomSoc,
        distance: '0.8 km away (2 mins)',
        timeAgo: 'Just now',
        tariff: 150,
        hostNet: 140,
        devCut: 10
      });
      renderHostRequests();
      playSynthBeep(760, 0.12);
      showToast(`New SOS Ping from ${randomName} (${randomSoc}% battery)!`);
    }

    // --- DEVELOPER WALLET & ₹150 SPLIT LEDGER ENGINE ---
    function record150SplitTransaction(riderLabel, hostLabel) {
      totalTransactions += 1;
      devWalletBalance += 10;
      hostWalletBalance += 140;
      hostSessionsCount += 1;
      hostKwhShared = +(hostKwhShared + 2.2).toFixed(1);
      hostKarma += 100;

      const txId = 'TX-' + (9930 + totalTransactions);
      splitLedger.unshift({
        id: txId,
        time: 'Just now',
        rider: riderLabel,
        host: hostLabel,
        gross: 150,
        hostShare: 140,
        devShare: 10
      });

      updateAllFinancialDisplays();
    }

    function simulateNew150Transaction() {
      const sampleRiders = ['Arjun N (450X)', 'Divya P (Rizta Z)', 'Nikhil B (450 Apex)', 'ishaan T (450S)'];
      const sampleHosts = ['Karthik Rao', 'Priya Nair', 'Ananya Sharma', 'Rohan Deshmukh'];
      const r = sampleRiders[Math.floor(Math.random() * sampleRiders.length)];
      const h = sampleHosts[Math.floor(Math.random() * sampleHosts.length)];

      record150SplitTransaction(r, h);
      playSynthBeep(920, 0.14, 'triangle');
      showToast(`Simulated ₹150 P2P Session! ₹140 sent to ${h} & +₹10 added to your Dev Wallet.`);
    }

    function withdrawDevCommission() {
      if (devWalletBalance <= 0) {
        showToast('Your Developer Commission balance is currently ₹0.');
        return;
      }
      const amount = devWalletBalance;
      devWalletBalance = 0;
      updateAllFinancialDisplays();
      playSynthBeep(880, 0.2, 'sine');
      showToast(`₹${amount} Developer Commission transferred to your linked UPI account!`);
    }

    function updateAllFinancialDisplays() {
      // Top Nav Badge & Dev Console
      document.getElementById('nav-dev-balance').textContent = `₹${devWalletBalance}`;
      document.getElementById('dev-wallet-balance').textContent = `₹${devWalletBalance.toLocaleString('en-IN')}`;
      document.getElementById('dev-tx-count').textContent = totalTransactions;
      document.getElementById('dev-gtv').textContent = `₹${(totalTransactions * 150).toLocaleString('en-IN')}`;
      document.getElementById('dev-host-total').textContent = `₹${(totalTransactions * 140).toLocaleString('en-IN')}`;

      // Host Console Metrics
      document.getElementById('host-wallet-balance').textContent = `₹${hostWalletBalance.toLocaleString('en-IN')}`;
      document.getElementById('host-sessions-count').textContent = hostSessionsCount;
      document.getElementById('host-kwh-shared').innerHTML = `${hostKwhShared} <span class="text-sm font-normal text-gray-400">kWh</span>`;
      document.getElementById('host-karma-points').innerHTML = `${hostKarma} <span class="text-sm font-normal text-gray-400">pts</span>`;

      // Render Ledger Table
      const tbody = document.getElementById('ledger-tbody');
      tbody.innerHTML = '';
      splitLedger.forEach(tx => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-ather-panel/40 transition';
        tr.innerHTML = `
          <td class="py-3 px-4 font-mono text-xs text-gray-300">${tx.id} <span class="text-gray-500 block text-[10px]">${tx.time}</span></td>
          <td class="py-3 px-4 font-medium text-white">${tx.rider}</td>
          <td class="py-3 px-4 text-gray-300">${tx.host}</td>
          <td class="py-3 px-4 font-mono font-bold text-white">₹${tx.gross}</td>
          <td class="py-3 px-4 font-mono font-semibold text-ather-mint">₹${tx.hostShare}</td>
          <td class="py-3 px-4 font-mono font-bold text-sky-400">+₹${tx.devShare}</td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-ather-mint/15 text-ather-mint border border-ather-mint/30">SPLIT SETTLED</span>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    // --- TOAST NOTIFICATION HELPER ---
    function showToast(message) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'pointer-events-auto bg-ather-panel border border-ather-mint/50 text-white px-4 py-3 rounded-xl shadow-2xl flex items-center gap-3 text-xs font-medium transition-all';
      toast.innerHTML = `
        <div class="w-6 h-6 rounded-lg bg-ather-mint/20 text-ather-mint flex items-center justify-center shrink-0">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <span>${message}</span>
      `;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3600);
    }

    // --- INITIALIZE ON LOAD ---
    window.onload = function () {
      updateBattery(7);
      renderHostRequests();
      updateAllFinancialDisplays();
    };
  </script>
</body>
</html>